{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "archive": {
      "type": "local",
      "command": ["node", "server/archive-mcp-server.js"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "read": { "*": "allow" },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "npm test": "allow"
    }
  }
}
